{
  "name": "yajlib",
  "version": "0.0.0",
  "description": "Typed, composable HTTP client with compile-time path param enforcement",
  "license": "MIT",
  "author": "Mohamed Ragaiy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mox93/yajlib"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "compat": "bun run build && bash compat/check.sh"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "arktype": "^2.2.8",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=18"
  }
}
